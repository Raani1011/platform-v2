# JWT signing key: generated by Terraform, stored only in Secrets Manager
resource "random_password" "jwt" {
  length  = 64
  special = false
}

resource "aws_secretsmanager_secret" "jwt" {
  name                    = "${var.project}/jwt-secret"
  description             = "JWT signing key shared by users-service and notes-service"
  recovery_window_in_days = 0 # delete immediately on destroy, so the name is free next session
}

resource "aws_secretsmanager_secret_version" "jwt" {
  secret_id     = aws_secretsmanager_secret.jwt.id
  secret_string = jsonencode({ JWT_SECRET = random_password.jwt.result })
}

# IAM role for External Secrets Operator (IRSA)
# Only the external-secrets service account can assume it,
# and it can only read these two secrets.
module "eso_irsa" {
  source  = "terraform-aws-modules/iam/aws//modules/iam-role-for-service-accounts-eks"
  version = "~> 5.0"

  role_name                      = "${var.project}-eso"
  attach_external_secrets_policy = true

  external_secrets_secrets_manager_arns = [
    aws_db_instance.postgres.master_user_secret[0].secret_arn,
    aws_secretsmanager_secret.jwt.arn,
  ]

  oidc_providers = {
    main = {
      provider_arn               = module.eks.oidc_provider_arn
      namespace_service_accounts = ["external-secrets:external-secrets"]
    }
  }
}
